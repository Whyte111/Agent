# 复制为 .env 后填写；留空即进入 mock / dry-run，不影响本机自检
# ---- LLM（OpenAI 兼容）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MOCK=0

# ---- SMTP（QQ/163/企业邮箱均可，注意用"授权码"不是登录密码）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SSL=1
MAIL_DRY_RUN=0

# ---- 搜索（百度千帆 AI 搜索，可选；留空则 web_search 明确报错）----
SEARCH_API=
SEARCH_TIMEOUT=20

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ALLOW_REMOTE=0
MAX_UPLOAD_MB=20
